{
  "name": "@spr/datasphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run migrate && node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node dist/migrate.js",
    "probe": "node dist/probe.js"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5",
    "@fastify/rate-limit": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
