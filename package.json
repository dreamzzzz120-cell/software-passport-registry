{
  "name": "software-passport-registry",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --import tsx server.ts",
    "build": "cross-env NODE_ENV=production vite build && node scripts/prerender-public-routes.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/worker.cjs && esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/migrate.cjs && esbuild scripts/provision-runtime-roles.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/provision-runtime-roles.cjs",
    "build:owner-bootstrap": "esbuild scripts/bootstrap-initial-owner.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/bootstrap-initial-owner.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "release": "node dist/migrate.cjs && node dist/provision-runtime-roles.cjs",
    "worker": "cross-env NODE_ENV=production node dist/worker.cjs",
    "worker:dev": "tsx worker.ts",
    "ai:gateway": "tsx index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "provision:roles": "tsx scripts/provision-runtime-roles.ts",
    "clean": "node -e \"import { rm } from 'fs/promises'; await rm('dist', { recursive: true, force: true }); await rm('server.js', { force: true });\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip:full": "node scripts/make-full-zip.js"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@sentry/node": "^10.72.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.2",
    "ai": "^7.0.84",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.37.0",
    "lucide-react-base": "npm:lucide-react@^0.468.0",
    "motion": "^13.1.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "stripe": "^22.6.0",
    "undici": "^8.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.0",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "@esbuild-kit/esm-loader": {
      "esbuild": "0.28.1"
    },
    "uuid": "11.1.1",
    "recast": "0.24.1"
  }
}
