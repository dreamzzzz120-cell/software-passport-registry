{
  "name": "software-passport-registry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --import tsx --import ./src/connect-preload.ts server.ts",
    "build": "cross-env NODE_ENV=production vite build && esbuild src/connect-preload.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/connect-preload.cjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/worker.cjs && esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/migrate.cjs",
    "build:owner-bootstrap": "esbuild scripts/bootstrap-initial-owner.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/bootstrap-initial-owner.cjs",
    "start": "cross-env NODE_ENV=production node -r ./dist/connect-preload.cjs dist/server.cjs",
    "worker": "cross-env NODE_ENV=production node dist/worker.cjs",
    "worker:dev": "tsx worker.ts",
    "ai:gateway": "tsx index.ts",
    "clean": "node -e \"import { rm } from 'fs/promises'; await rm('dist', { recursive: true, force: true }); await rm('server.js', { force: true });\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip:full": "node scripts/make-full-zip.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/node": "^10.68.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "ai": "^6.0.0",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.0.0",
    "express": "^4.18.2",
    "firebase": "^10.8.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.3",
    "lucide-react": "^0.292.0",
    "motion": "^10.16.16",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.10.3",
    "stripe": "^14.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@tailwindcss/vite": "^4.1.14",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.20.13",
    "drizzle-orm": "^0.29.4",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "vite": "^5.0.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "@esbuild-kit/core-utils": { "esbuild": "0.28.1" },
    "@esbuild-kit/esm-loader": { "esbuild": "0.28.1" },
    "uuid": "11.1.1",
    "recast": "0.24.1"
  }
}
