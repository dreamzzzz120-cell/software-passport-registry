# SPR PRODUCTION ENVIRONMENT CONTRACT
# Copy the appropriate variables into Railway and Vercel.
# NEVER put real secrets in this file or commit .env.local/.env.production.

# ============================================================
# RAILWAY — REQUIRED FOR PRODUCTION BACKEND
# ============================================================
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_URL=https://YOUR-RAILWAY-DOMAIN
APP_ALLOWED_ORIGINS=https://YOUR-RAILWAY-DOMAIN,https://YOUR-VERCEL-DOMAIN
ENFORCE_HTTPS=true
TRUST_PROXY=true
ALLOW_IFRAME=false
REQUEST_BODY_LIMIT=2mb

# PostgreSQL: use DATABASE_URL OR the SQL_* group.
DATABASE_URL=
# SQL_HOST=
# SQL_USER=
# SQL_PASSWORD=
# SQL_DB_NAME=
SQL_SSL=require
SQL_POOL_MAX=20
SQL_CONNECTION_TIMEOUT_MS=10000
SQL_IDLE_TIMEOUT_MS=30000
SQL_QUERY_TIMEOUT_MS=5000

REDIS_URL=

# Optional Row-Level Security hardening (migration 0020). Leave both blank to
# keep running everything as the DATABASE_URL owner role (current default
# behavior, unchanged). To adopt it: run migrations, then
# `npm run provision:roles` with APP_RUNTIME_DB_PASSWORD/WORKER_RUNTIME_DB_PASSWORD
# set, then point these at the same host/database using those role names.
APP_DATABASE_URL=
WORKER_DATABASE_URL=
# Only used by scripts/provision-runtime-roles.ts; never read by the app itself.
APP_RUNTIME_DB_PASSWORD=
WORKER_RUNTIME_DB_PASSWORD=

# Supabase Auth (server side). SUPABASE_URL is shared with the intake section
# below. The publishable (or legacy anon) key verifies user access tokens; the
# service-role/secret key is for admin operations (list/create/ban users).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# RAILWAY — OPTIONAL / FEATURE-SPECIFIC
# ============================================================
AI_GATEWAY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# Credential vault: base64url encoding of exactly 32 random bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Store ONLY in the backend secret manager (Railway), never in source control or Vercel.
SPR_CREDENTIAL_ENCRYPTION_KEY=
SPR_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# Initial owner bootstrap: either leave ALL blank or provide ALL three.
SPR_INITIAL_OWNER_EMAIL=
SPR_OWNER_BOOTSTRAP_SECRET=
SPR_OWNER_BOOTSTRAP_SECRET_SHA256=

# Development/test-only override. Production rate limiting must fail closed.
# RATE_LIMIT_FAIL_OPEN=false

# ============================================================
# VERCEL — FRONTEND
# ============================================================
# Supabase browser configuration. Inlined into the client bundle at build time
# by vite.config.ts; the publishable key is public by design. Set these on
# Vercel AND on the Railway app service (its image serves the SPA shell too).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Make `vite build` fail when the two values above are missing, instead of
# shipping a bundle whose login screen cannot work.
SPR_REQUIRE_SUPABASE_CONFIG=true

# Vercel AI Gateway, if the frontend/serverless AI path uses it.
AI_GATEWAY_API_KEY=

# Railway API origin used by the frontend if the app expects this variable.
# VITE_API_URL=https://YOUR-RAILWAY-DOMAIN

# ============================================================
# DO NOT PUT THESE IN VERCEL
# ============================================================
# DATABASE_URL / SQL_PASSWORD
# APP_DATABASE_URL / WORKER_DATABASE_URL / APP_RUNTIME_DB_PASSWORD / WORKER_RUNTIME_DB_PASSWORD
# REDIS_URL
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
# SPR_OWNER_BOOTSTRAP_SECRET / SPR_OWNER_BOOTSTRAP_SECRET_SHA256
# SPR_CREDENTIAL_ENCRYPTION_KEY
# SENTRY_AUTH_TOKEN (if introduced later)

# --- Universal Intake storage (Supabase) ---
# SUPABASE_URL: the project URL. Its origin is added to the CSP connect-src so
# the browser may PUT directly to the signed upload URL.
SUPABASE_URL="https://your-project.supabase.co"
# Server-side key used to mint signed upload URLs. Supabase renamed this: current
# projects issue a "secret key", older ones a service_role JWT. Either name works.
# Without it /api/intake/upload-url answers 503 and Universal Intake is dead.
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"
# SPR_INTAKE_BUCKET: storage bucket for quarantined intake files. This is the
# name src/routes/universal-intake.ts actually reads; defaults to spr-intake.
SPR_INTAKE_BUCKET="spr-intake"
